CONFIG_UK_ARCH="arm64"
CONFIG_ARCH_ARM_64=y
CONFIG_MCPU_ARM64_GENERIC=y
CONFIG_LIBUKRANDOM_LCPU=n
CONFIG_LIBUKINTCTLR_GICV3=y
CONFIG_LIBUKTTY_PL011_EARLY_CONSOLE=n
CONFIG_LIBUKTTY_NS16550_EARLY_CONSOLE=n

# Static-PIE so relocatable loaders (vz VZLinuxBootLoader, EFI) accept the
# Image and libukreloc relocates it from any load base.
CONFIG_OPTIMIZE_PIE=y
