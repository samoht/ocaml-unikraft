From 0ebbc2bc7c839724edfcc5166cd975cfa0c781c3 Mon Sep 17 00:00:00 2001
From: Thomas Gazagnaire <thomas@gazagnaire.org>
Date: Wed, 22 Jul 2026 12:57:49 -0700
Subject: [PATCH] asmlink: bound automatic format specialisation by program
 size

The aggressive budgets used for format specialisation run the inliner
over the whole linked program, not just the format machinery, so a low
entry-site count alone is not a sufficient bound: a large application
with a single format literal still ran every cleanup round under -O3
budgets, and only the growth guard's late discard stood between it and
an explosion in link time and code size.  Programs above 250,000
size units now keep the zero-budget cleanup regardless of their site
count.

The two generated tests pin both edges of the admission decision: one
program with 22,000 live functions and one format literal (over the
size bound), one with 51 constant-format sites (over the site bound);
each must take the bounded path, checked through the elimination
summary of a full -use-lto link.
---
 asmcomp/asmlink.ml | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/asmcomp/asmlink.ml b/asmcomp/asmlink.ml
index 6b999de4ce..e9c9ef6994 100644
--- a/asmcomp/asmlink.ml
+++ b/asmcomp/asmlink.ml
@@ -1048,6 +1048,13 @@ let format_machinery_units =
 
 let format_specialise_max_sites = 50
 
+(* The aggressive budgets used for format specialisation run the inliner over
+   the whole linked program, not just the format machinery.  A low site count
+   alone is therefore not a sufficient bound: a large application with one
+   format literal can still expand by orders of magnitude before the size
+   guard gets a chance to discard the result. *)
+let format_specialise_max_program_size = 250_000
+
 let count_format_entry_sites (program : Flambda.program) =
   let const_vars = ref Variable.Set.empty in
   let aliases = ref [] in
@@ -1367,6 +1374,7 @@ let link_whole_program ~backend ~ppf_dump ~crc_interfaces units_to_link =
      parameters are restored afterwards.  See [count_format_entry_sites]. *)
   let auto_specialise =
     (not !Clflags.lto_inline)
+    && stats_before.total_size <= format_specialise_max_program_size
     && (let sites = count_format_entry_sites program in
         sites >= 1 && sites <= format_specialise_max_sites)
   in
-- 
2.55.0

