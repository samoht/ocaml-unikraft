From 2f31487d1749548b617526f27d6c9cb4d63fbe35 Mon Sep 17 00:00:00 2001
From: Thomas Gazagnaire <thomas@gazagnaire.org>
Date: Mon, 20 Jul 2026 20:56:43 -0700
Subject: [PATCH] asmlink: guard only the inlining stage, after collecting its
 result

The round-level size guard threw out the good with the bad: a round that
grew from a runaway specialisation also carried that round's legitimate
eliminations, and discarding the whole round reverted them.  The shrink
passes (constructs, evaluation, purity, closure variables) now commit
unconditionally; a snapshot is taken and only the inlining stage is
guarded against it.  Growth is judged after cleaning the inlined result,
because a single-use move counts twice until the abandoned original is
collected; measuring too early made the guard discard the collapse it
exists to protect.  The motivating shape still folds completely, and a
growing specialisation now costs one wasted stage per round instead of
the round's progress.
---
 asmcomp/asmlink.ml | 42 ++++++++++++++++++++++++++----------------
 1 file changed, 26 insertions(+), 16 deletions(-)

diff --git a/asmcomp/asmlink.ml b/asmcomp/asmlink.ml
index 037146a339..e87aaa9219 100644
--- a/asmcomp/asmlink.ml
+++ b/asmcomp/asmlink.ml
@@ -1353,10 +1353,7 @@ let link_whole_program ~backend ~ppf_dump ~crc_interfaces units_to_link =
      round can expose more dead code.  Terminates because a further round is
      only attempted while the function count strictly shrinks. *)
   let rec clean program =
-    let saved = program in
-    let stats = program_stats program in
-    let count = stats.fun_count in
-    let size_before = stats.total_size in
+    let count = (program_stats program).fun_count in
     let program =
       Remove_unused_program_constructs.remove_unused_program_constructs program
     in
@@ -1370,6 +1367,12 @@ let link_whole_program ~backend ~ppf_dump ~crc_interfaces units_to_link =
       Remove_unused_closure_vars.remove_unused_closure_variables
         ~remove_direct_call_surrogates:false program
     in
+    (* Everything up to here only removes; it is committed unconditionally.
+       The inlining stage below is the only one that can grow the program,
+       so it alone is guarded: if its result is materially larger than the
+       snapshot, the stage is discarded and the round keeps the cleanups. *)
+    let shrunk = program in
+    let size_shrunk = (program_stats shrunk).total_size in
     let program =
       (* Inlining here is opt-in: with the whole program in view it can
          specialise an interpreter over its statically known data (unrolling
@@ -1384,18 +1387,25 @@ let link_whole_program ~backend ~ppf_dump ~crc_interfaces units_to_link =
         ~round:0
         program
     in
-    let stats = program_stats program in
-    if stats.total_size > size_before + size_before / 4 then begin
-      (* Safety net over every pass in the round: cleanup must never grow
-         the program materially.  A round that does is discarded and the
-         fixpoint ends with the pre-round program. *)
-      Printf.eprintf
-        "-use-lto: cleanup round grew the program (%d -> %d size units); \
-         discarding it\n%!"
-        size_before stats.total_size;
-      saved
-    end
-    else if stats.fun_count < count then clean program
+    let program =
+      (* Collect before judging: a single-use move counts twice until the
+         abandoned original is removed, so growth is only real if it
+         survives a cleanup of the inlined result. *)
+      Remove_unused_program_constructs.remove_unused_program_constructs
+        program
+    in
+    let program =
+      let sz = (program_stats program).total_size in
+      if sz > size_shrunk + size_shrunk / 4 then begin
+        Printf.eprintf
+          "-use-lto: inlining stage grew the program (%d -> %d size \
+           units); keeping the cleanups and discarding it\n%!"
+          size_shrunk sz;
+        shrunk
+      end
+      else program
+    in
+    if (program_stats program).fun_count < count then clean program
     else program
   in
   let cleaned_program = with_specialise_budgets (fun () -> clean program) in
-- 
2.55.0

