From 855fec8e36570b1679e09e49a783bead8a355a8a Mon Sep 17 00:00:00 2001
From: Thomas Gazagnaire <thomas@gazagnaire.org>
Date: Mon, 20 Jul 2026 21:43:18 -0700
Subject: [PATCH] asmlibrarian: gate the code-less-member warning on -use-lto

The archive path fired warning 76 for any member without stored code
whenever the compiler was configured with --enable-lto, consulting only
Config.cmx_contains_all_code.  Since -opaque units deliberately store no
code, every dev-profile dune build (which compiles with -opaque) warned
on every cmxa, and dune's -warn-error promoted that to a hard error:
the whole tree stopped archiving while plain links worked.  Gate the
warning on whole_program_rebuild exactly as in Compilenv.write_unit_info:
a code-less member is fully legitimate unless this archive step is
itself part of a -use-lto build.  ocamlopt -opaque -c m.ml && ocamlopt
-a is silent again; the same archive under -use-lto still warns.
---
 asmcomp/asmlibrarian.ml | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/asmcomp/asmlibrarian.ml b/asmcomp/asmlibrarian.ml
index 74be0eaf12..26b7523a65 100644
--- a/asmcomp/asmlibrarian.ml
+++ b/asmcomp/asmlibrarian.ml
@@ -42,7 +42,13 @@ let read_info name =
     match info.ui_export_info with
     | Flambda export_info ->
         if Config.cmx_contains_all_code then begin
-          if export_info.Export_info.code = None then
+          (* As in [Compilenv.write_unit_info]: a code-less member (an
+             -opaque unit, e.g. every dev-profile compile under dune) is
+             fully legitimate unless this archive step is itself part of a
+             -use-lto build; emitted unconditionally, the warning turned
+             every dev cmxa into a hard error under -warn-error. *)
+          if export_info.Export_info.code = None
+             && !Clflags.whole_program_rebuild then
             Location.prerr_warning Location.none
               (Warnings.Module_compiled_without_lto info.ui_name);
           Cmx_format.Flambda
