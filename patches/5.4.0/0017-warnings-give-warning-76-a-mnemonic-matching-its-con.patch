From c22ee884f1f43033d7d0bcda3495187719cdf2df Mon Sep 17 00:00:00 2001
From: Thomas Gazagnaire <thomas@gazagnaire.org>
Date: Mon, 20 Jul 2026 11:24:13 -0700
Subject: [PATCH] warnings: give warning 76 a mnemonic matching its constructor

The mnemonics testsuite check derives the expected constructor name from
each mnemonic; "module-without-lto" cannot correspond to
Module_compiled_without_lto, so the check failed on both counts.  Rename
the mnemonic to "module-compiled-without-lto".
---
 utils/warnings.ml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/utils/warnings.ml b/utils/warnings.ml
index 4d857c669d..588bc80d0b 100644
--- a/utils/warnings.ml
+++ b/utils/warnings.ml
@@ -555,7 +555,7 @@ let descriptions = [
                    type.";
     since = since 5 4 };
   { number = 76;
-    names = ["module-without-lto"];
+    names = ["module-compiled-without-lto"];
     description = "Dependency on a module compiled without -lto.";
     since = since 5 4 };
 ]
-- 
2.55.0

