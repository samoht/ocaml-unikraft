From 0ee2c3e236e103cdc546ca5879b55bae798c9376 Mon Sep 17 00:00:00 2001
From: Thomas Gazagnaire <thomas@gazagnaire.org>
Date: Sun, 12 Jul 2026 15:40:00 -0700
Subject: [PATCH] Default -function-sections to the configured support

The cross compiler is configured with function-sections support, but
emission stayed opt-in per invocation: only build systems that know to
pass -function-sections get collectable sections, so the toolchain's
own stdlib had them while every dune- or opam-built target library did
not, and -Wl,--gc-sections at unikernel link time had almost nothing
to collect.

Default Clflags.function_sections to Config.function_sections: a
compiler built with support emits sections everywhere by default (the
flag remains available), and a compiler built without support keeps
the false default. Host compilers are separate builds and unaffected.
---
 utils/clflags.ml | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/utils/clflags.ml b/utils/clflags.ml
index 0f3c408559..b14931dac4 100644
--- a/utils/clflags.ml
+++ b/utils/clflags.ml
@@ -201,7 +201,8 @@ let afl_instrument = ref Config.afl_instrument (* -afl-instrument *)
 let afl_inst_ratio = ref 100           (* -afl-inst-ratio *)
 let whole_program_rebuild = ref false  (* -use-lto *)
 
-let function_sections = ref false      (* -function-sections *)
+let function_sections = ref Config.function_sections
+                                        (* -function-sections *)
 
 let simplify_rounds = ref None        (* -rounds *)
 let default_simplify_rounds = ref 1        (* -rounds *)
-- 
