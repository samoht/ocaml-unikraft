From 6f663c8b1513b50935f0de13acee93e74234bef0 Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Fri, 17 Jul 2026 23:17:06 -0700
Subject: [PATCH] asmlink: report -use-lto dead-code elimination stats

After the whole-program cleanup, print how many function declarations were
retained versus present in the concatenated program, so a -use-lto link gives
feedback on how much dead code it removed, e.g.

  -use-lto: kept 189 of 1087 functions, eliminated 898 as dead code (82.6%)

Functions are counted with Flambda_iterators over nested and top-level
closures alike, so the figure is stable across the Lift_constants pass.
---
 asmcomp/asmlink.ml | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/asmcomp/asmlink.ml b/asmcomp/asmlink.ml
index 39266462fe..e14c9d2ceb 100644
--- a/asmcomp/asmlink.ml
+++ b/asmcomp/asmlink.ml
@@ -370,6 +370,16 @@ let compile_implementation_flambda ~unit_prefix ~backend
     in
     Asmgen.end_gen_implementation ~ppf_dump clambda_with_constants)
 
+(* Total function declarations in a whole-program Flambda term, counting nested
+   closures as well as top-level ones, so the figure is comparable before and
+   after [Lift_constants] hoists closures to the top level. *)
+let count_functions program =
+  let n = ref 0 in
+  Flambda_iterators.iter_on_set_of_closures_of_program program
+    ~f:(fun ~constant:_ (set : Flambda.set_of_closures) ->
+      n := !n + Variable.Map.cardinal set.function_decls.funs);
+  !n
+
 let link_whole_program ~backend ~ppf_dump ~crc_interfaces units_to_link =
   let codes = get_flambda_codes units_to_link in
   let program =
@@ -383,6 +393,7 @@ let link_whole_program ~backend ~ppf_dump ~crc_interfaces units_to_link =
   in
   Compilation_unit.set_current compilation_unit;
   let program = Flambda_utils.replace_compilation_unit_of_symbols compilation_unit program in
+  let functions_before = count_functions program in
   (* No [Flambda_invariants.check_exn] here: the concatenated program mixes
      variables from several compilation units (their [Set_of_closures_id] etc.
      deliberately keep their originating unit, which [Flambda_to_clambda] relies
@@ -415,6 +426,15 @@ let link_whole_program ~backend ~ppf_dump ~crc_interfaces units_to_link =
     Let_symbol (Compilenv.current_unit_symbol (), Block (Tag.create_exn 0, []),
                 cleaned_program.program_body) in
   let cleaned_program = { program with program_body } in
+  let functions_after = count_functions cleaned_program in
+  let removed = functions_before - functions_after in
+  let pct =
+    if functions_before = 0 then 0.
+    else 100. *. float_of_int removed /. float_of_int functions_before
+  in
+  Printf.eprintf
+    "-use-lto: kept %d of %d functions, eliminated %d as dead code (%.1f%%)\n%!"
+    functions_after functions_before removed pct;
   compile_implementation_flambda
     ~unit_prefix
     ~backend
-- 
2.55.0

