From e2a4c0860572895027befd329e6217630d148391 Mon Sep 17 00:00:00 2001
From: Thomas Gazagnaire <thomas@gazagnaire.org>
Date: Fri, 17 Jul 2026 12:31:30 -0700
Subject: [PATCH] Bring OCaml domains up on bare secondary lcpus for mirage-eio
 SMP

mirage-eio's Executor_pool runs one OCaml domain per secondary CPU. On a
freestanding target the platform hands a worker a bare secondary core with
no uk-thread context, so Domain.spawn (which needs a host thread) cannot be
used to enter it. caml_lcpu_run_entry sets a fresh domain up directly on the
core -- the same domain_create + domain-init-hook sequence domain_thread_func
runs -- and calls a named OCaml entry that runs a scheduler there.

A domain created outside Domain.spawn also skips the DLS.create_dls its body
runs, so Domain.DLS.get (reached from Eio's Fiber_context.make_root) faults on
the uninitialised domain-local state. Expose that initialiser to the runtime as
the named value caml_lcpu_dls_init and call it before the entry. The binding is
implementation-only, so the domain interface -- and its cmi crc -- is unchanged.
---
 runtime/domain.c | 33 +++++++++++++++++++++++++++++++++
 stdlib/domain.ml | 11 +++++++++++
 2 files changed, 44 insertions(+)

diff --git a/runtime/domain.c b/runtime/domain.c
index 221c66e..f3ba5df 100644
--- a/runtime/domain.c
+++ b/runtime/domain.c
@@ -1381,6 +1381,67 @@ CAMLprim value caml_domain_spawn(value callback, value term_sync)
 
   CAMLreturn (Val_long(p.unique_id));
 }
+/* Blacksun/mirage-eio SMP: bring a fresh OCaml domain up on a bare secondary
+   lcpu and hand control to the OCaml worker entry. The platform's per-lcpu
+   start dispatches it to an idle secondary; it sets the domain up the same way
+   Domain.spawn does -- domain_create, the domain-init hook, and the
+   domain-local storage the effect/fiber libraries rely on -- then calls the
+   registered "mirage_lcpu_entry" closure, which runs a scheduler on this core.
+   [ctl] is a small control block shared with the boot core: ctl[0] is a status
+   word (2 = entered, 1 = domain up and entry called, negative = failed),
+   ctl[2] the slot index passed to the entry, ctl[4] a completion counter. All
+   handshaking is by polling shared memory, so no cross-lcpu wakeup is needed. */
+CAMLexport void caml_lcpu_run_entry(caml_domain_state *parent,
+                                    volatile long *ctl)
+{
+  ctl[0] = 2; __sync_synchronize();
+  /* Reproduce domain_thread_func's lifecycle so a domain brought up here is a
+     full STW participant: signal stack, thread id, and backup thread, not just
+     domain_create. Without the backup thread a blocking section with several
+     domains live cannot service STW requests. */
+  void *signal_stack = caml_init_signal_stack();
+  if (signal_stack == NULL) { ctl[0] = -3; __sync_synchronize(); return; }
+  if (domain_self == NULL)
+    domain_create(caml_params->init_minor_heap_wsz, parent);
+  if (domain_self == NULL) {
+    caml_free_signal_stack(signal_stack);
+    ctl[0] = -1; __sync_synchronize(); return;
+  }
+  domain_self->tid = pthread_self();
+  install_backup_thread(domain_self);
+  /* Per-domain init a normally-spawned domain gets; effect/fiber libraries
+     register domain-local state here. */
+  caml_domain_initialize_hook();
+  /* caml_callback_exn does not propagate: a raised exception must not bypass
+     the termination and cleanup below. Publish a failure code but always
+     terminate. The DLS init (Domain.spawn runs it via DLS.create_dls; a domain
+     brought up outside spawn must too, or Domain.DLS.get faults) and the entry
+     both run this way. */
+  long fail = 0;
+  const value *dls_init = caml_named_value("caml_lcpu_dls_init");
+  if (dls_init != NULL
+      && Is_exception_result(caml_callback_exn(*dls_init, Val_unit)))
+    fail = -4;
+  const value *entry = caml_named_value("mirage_lcpu_entry");
+  if (entry == NULL) {
+    fail = -2;
+  } else {
+    ctl[0] = 1; __sync_synchronize();
+    if (Is_exception_result(caml_callback_exn(*entry, Val_long(ctl[2]))))
+      fail = -5;
+  }
+  /* Terminate on every path once the domain exists: join its systhreads, leave
+     the stop-the-world set, release its roots and heaps. Then clear the
+     thread-local domain pointer so a later dispatch onto this core creates a
+     fresh domain rather than reusing the terminated one. [false]: never the
+     last domain. */
+  caml_domain_terminate(false);
+  domain_self = NULL;
+  caml_free_signal_stack(signal_stack);
+  if (fail) { ctl[0] = fail; __sync_synchronize(); }
+  ctl[4]++;
+  __sync_synchronize();
+}
 
 CAMLprim value caml_ml_domain_id(value unit)
 {
diff --git a/stdlib/domain.ml b/stdlib/domain.ml
index d0d8c29..5df1cd9 100644
--- a/stdlib/domain.ml
+++ b/stdlib/domain.ml
@@ -299,3 +299,14 @@ let join { term_sync ; _ } =
   | Error ex -> raise ex
 
 let recommended_domain_count = Raw.get_recommended_domain_count
+
+(* Blacksun/mirage-eio SMP: expose the per-domain DLS initialiser so a domain
+   brought up on a bare secondary lcpu -- outside Domain.spawn, by the runtime's
+   caml_lcpu_run_entry -- can allocate its domain-local storage. Without it
+   Domain.DLS.get faults on the uninitialised state. Not in the interface: it is
+   an internal hook the runtime looks up by name, not public API. *)
+external register_named_value : string -> Obj.t -> unit
+  = "caml_register_named_value"
+
+let () = register_named_value "caml_lcpu_dls_init" (Obj.repr DLS.create_dls)
+
-- 
