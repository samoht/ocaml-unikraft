From d775aa2d3999d9fa5dfc33e3e3733b0ac4639b32 Mon Sep 17 00:00:00 2001
From: Thomas Gazagnaire <thomas@gazagnaire.org>
Date: Mon, 20 Jul 2026 20:04:34 -0700
Subject: [PATCH] asmlink: size-guard the cleanup fixpoint; unroll only on true
 constants

The single-use collapse accepted any immutable block as a structurally
constant argument, so a cons cell of runtime data qualified and a
runtime-length walker could be peeled once per cleanup round for as long
as unrelated elimination kept the fixpoint running; on a large program
this compounded into a seventy-fold flambda-level code-size explosion,
reported as a negative elimination percentage and dying in the assembler
with pc-relative offsets out of range.  The Unroll marking now requires
a true constant (a constant, symbol, or symbol-field read, through plain
aliases only), which still folds the literal-device-list case.

Independently, the fixpoint now measures the program after every round
and discards any round that grew it by more than a quarter, ending with
the pre-round program and saying so: no current or future pass in the
cleanup can compound growth into an unbuildable program again.
---
 asmcomp/asmlink.ml | 28 +++++++++++++++++++++++-----
 1 file changed, 23 insertions(+), 5 deletions(-)

diff --git a/asmcomp/asmlink.ml b/asmcomp/asmlink.ml
index 13c0b94740..037146a339 100644
--- a/asmcomp/asmlink.ml
+++ b/asmcomp/asmlink.ml
@@ -1232,10 +1232,14 @@ let mark_single_use_applies (program : Flambda.program) =
       Flambda_iterators.iter_all_immutable_let_bindings expr
         ~f:(fun var (named : Flambda.named) ->
           match named with
-          | Const _ | Symbol _ | Allocated_const _ | Read_symbol_field _
-          | Prim (Pmakeblock (_, Immutable, _), _, _) ->
+          (* True constants only: an immutable block or a field projection
+             can wrap runtime data, and treating those as constant let a
+             runtime-length walker be peeled once per cleanup round, which
+             compounded into a runaway (a seventy-fold code-size explosion
+             and pc-relative offsets out of assembler range downstream). *)
+          | Const _ | Symbol _ | Allocated_const _ | Read_symbol_field _ ->
             struct_consts := Variable.Set.add var !struct_consts
-          | Expr (Var a) | Prim (Pfield _, [a], _) ->
+          | Expr (Var a) ->
             aliases := (var, a) :: !aliases
           | _ -> ()));
   let rec close () =
@@ -1349,7 +1353,10 @@ let link_whole_program ~backend ~ppf_dump ~crc_interfaces units_to_link =
      round can expose more dead code.  Terminates because a further round is
      only attempted while the function count strictly shrinks. *)
   let rec clean program =
-    let count = (program_stats program).fun_count in
+    let saved = program in
+    let stats = program_stats program in
+    let count = stats.fun_count in
+    let size_before = stats.total_size in
     let program =
       Remove_unused_program_constructs.remove_unused_program_constructs program
     in
@@ -1377,7 +1384,18 @@ let link_whole_program ~backend ~ppf_dump ~crc_interfaces units_to_link =
         ~round:0
         program
     in
-    if (program_stats program).fun_count < count then clean program
+    let stats = program_stats program in
+    if stats.total_size > size_before + size_before / 4 then begin
+      (* Safety net over every pass in the round: cleanup must never grow
+         the program materially.  A round that does is discarded and the
+         fixpoint ends with the pre-round program. *)
+      Printf.eprintf
+        "-use-lto: cleanup round grew the program (%d -> %d size units); \
+         discarding it\n%!"
+        size_before stats.total_size;
+      saved
+    end
+    else if stats.fun_count < count then clean program
     else program
   in
   let cleaned_program = with_specialise_budgets (fun () -> clean program) in
-- 
2.55.0

